{
  "manifest_version": 3,
  "name": "TTD Smart Autofill",
  "version": "1.0.0",
  "description": "Securely store pilgrim profiles and fill TTD Special Entry Darshan booking forms with a single click.",
  "author": "TTD Smart Autofill",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://ttdevasthanams.ap.gov.in/*",
    "https://www.ttdevasthanams.ap.gov.in/*"
  ],

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TTD Smart Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://www.ttdevasthanams.ap.gov.in/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://www.ttdevasthanams.ap.gov.in/*"
      ]
    }
  ]
}
